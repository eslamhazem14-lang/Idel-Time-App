# ---------------------------------------------------------------------------
# IdleTime — environment configuration
# Copy to .env, then: php artisan key:generate
# ---------------------------------------------------------------------------
APP_NAME=IdleTime
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://idletime.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Comma-separated proxy IPs (load balancer / Cloudflare) or * behind a trusted proxy only
TRUSTED_PROXIES=127.0.0.1

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (MySQL 8 / MariaDB 10.6+) -------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=idle_time
DB_USERNAME=idle
DB_PASSWORD=change-me

# --- Sessions (secure cookies in production) --------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Private disk for task/submission attachments (never the public disk)
ATTACHMENTS_DISK=local

# Notifications + mail are queued: run `php artisan queue:work` (see docs/DEPLOYMENT.md).
# Use "sync" for local development without a worker.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (SMTP) ------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@idletime.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Platform defaults (admins can override these at runtime in Admin → Settings)
PLATFORM_COMMISSION_PERCENT=30.00
PLATFORM_MIN_WITHDRAWAL=10.00
PLATFORM_REQUIRE_EMAIL_VERIFICATION=true

# --- Payments: only the manual driver ships today (admin settles transfers) --
PAYOUT_DRIVER=manual
FUNDING_DRIVER=manual

# --- Seeding ----------------------------------------------------------------
# Used by `php artisan db:seed` (demo data). Never seed demo data in production;
# create the real admin with `php artisan platform:create-admin` instead.
SEED_ADMIN_EMAIL=admin@idletime.test
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=password

VITE_APP_NAME="${APP_NAME}"

# Watch & earn (rewarded video ads). See docs/ADS_AND_CLAUDE_CODE.md
ADS_ENABLED=true
AD_PROVIDER=demo
GOOGLE_AD_UNIT_PATH=
AD_REVENUE_SHARE_PERCENT=50.00
# Demo views count only when true (keep false in production)
ADS_PAY_DEMO_VIEWS=false
